# Copy to .env and fill in. .env is gitignored — never commit real keys.

# Required — Discord bot token (https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# AI chat — at least one of these (OpenRouter tried first, then Groq)
OPENROUTER_API_KEY=
GROQ_API_KEY=

# Voice / TTS — optional. Without a Fish key, Lisa falls back to gTTS.
FISH_AUDIO_API=
# Optional overrides (the /voice picker sets the voice at runtime instead):
# FISH_AUDIO_REFERENCE_ID=7e63bf5f79cc40b58383a1eae28f71c4
# FISH_AUDIO_MODEL=s2.1-pro-free

# Character avatars — optional. Drop pictures into data/character_avatars/
# yourself (see the README.txt generated there) and that's all you need. These
# two only enable an automatic Google Image fallback for characters without a
# saved picture — a Custom Search JSON API key + a Programmable Search Engine
# ID (cx) with Image Search turned on (https://programmablesearchengine.google.com/).
# GOOGLE_SEARCH_API_KEY=
# GOOGLE_SEARCH_CX=
