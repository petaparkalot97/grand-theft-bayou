      "text": "Found property."
    },
    {
      "id": "mercer_004",
      "character": "MERCER",
      "text": "Then I'll take it."
    },
    {
      "id": "keseme_064",
      "character": "KESEME",
      "text": "Evidence requires documentation."
    },
    {
      "id": "mercer_005",
      "character": "MERCER",
      "text": "You always this difficult?"
    },
    {
      "id": "keseme_065",
      "character": "KESEME",
      "text": "Only when people ask me to ignore procedure."
    },
    {
      "id": "mercer_006",
      "character": "MERCER",
      "text": "Procedure?"
    },
    {
      "id": "mercer_007",
      "character": "MERCER",
      "text": "Out here, young lady, procedure is whatever keeps everybody safe."
    },
    {
      "id": "keseme_066",
      "character": "KESEME",
      "text": "Interesting."
    },
    {
      "id": "mercer_008",
      "character": "MERCER",
      "text": "What's interesting?"
    },
    {
      "id": "keseme_067",
      "character": "KESEME",
      "text": "Nothing."
    },
    {
      "id": "mercer_009",
      "character": "MERCER",
      "text": "Good."
    },
    {
      "id": "mercer_010",
      "character": "MERCER",
      "text": "Bag."
    },
    {
      "id": "mercer_011",
      "character": "MERCER",
      "text": "You kids stay out of trouble."
