# source asset archives (huge, redistributable-license varies — keep local only)
*.rar
*.zip
*.7z
*.unitypackage
_extracted/

# blender source files
*.blend
*.blend1

# tooling / editor
.env
# External/source asset bundles are kept locally, not shipped in Git.
/assets/City Bowels
/assets/Los Santos Mini Map.bbdoc
.claude/
node_modules/
*.log
Thumbs.db
.DS_Store
desktop.ini

# scratch
/tmp/
scratchpad/

# headless QA screenshots (tools/qa/*.mjs)
tools/qa/out/

# generated by `npm run build` for static hosting; the dev server lists
# assets/music/ live instead
assets/music/playlist.json

# assets/audio/voice/ IS committed (needed for the static Cloudflare Pages
# deploy — nothing in the build step generates it, see wrangler.jsonc). Files
# are produced locally by `npm run voiceover` (tools/voiceover-gen.mjs) using
# FISH_AUDIO_API_KEY in .env, then committed like any other asset.

# mapEditor.js's dev-mode placement sessions — a runtime scratchpad written
# by server/index.js's /editor/save, not source content. "Export" in the
# editor is how a placement becomes real, committed code.
server/editor-placements.json

# tools/upload-assets-to-r2.sh's own run log — tools/r2-manifest.json (the
# useful output, consumed by mapEditor.js) is committed; this raw progress
# log isn't source content and is safe to regenerate.
tools/upload-log.txt

# Audio masters. Cloudflare Pages refuses any file over 25 MiB and a CD-quality
# wav of a four-minute track is ~46 MB, which broke the deploy. Keep the master
# locally; ship the encoded mp3 in assets/music/ (see that folder's README).
/*.wav
/*.aiff
/*.flac

# loose reference/scratch video dropped at the repo root — not game source,
# keep it local only (same rationale as the loose audio masters above).
/*.mp4
